<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Multi-target so net8.0 code paths (and the netstandard2.0 polyfill surface reachable through
         them) are actually exercised alongside net10.0. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <!-- v3 test projects are executables; Main is generated by xunit.v3.core. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Enigma.Core/Enigma.Core.csproj" />
  </ItemGroup>
  <!-- CSV test-vector convention: vector files are copied next to the test assembly so
       CsvData.Rows can load them by relative path. This glob keeps the convention in place; each
       implementation feature only needs to drop its per-module CSV under the test project. -->
  <ItemGroup>
    <None Update="**/*.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
